generator client {
  provider               = "prisma-client-js"
  moduleFormat           = "esm"
  generatedFileExtension = "js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}


enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum SubscriptionPlan {
  NON_PREMIUM
  PREMIUM
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ParticipantStatus {
  WAITING
  ACTIVE
  DISCONNECTED
  LEFT
}

enum ParticipantRole {
  INTERVIEWER
  CANDIDATE
  OBSERVER
}


enum CompanySize {
  ONE_TO_TEN 
  ELEVEN_TO_FIFTY 
  FIFTY_ONE_TO_TWO_HUNDRED 
  TWO_HUNDRED_ONE_TO_FIVE_HUNDRED 
  FIVE_HUNDRED_ONE_TO_THOUSAND 
  THOUSAND_PLUS 
}


enum Industry {
  TECHNOLOGY
  HEALTHCARE
  FINANCE
  EDUCATION
  RETAIL
  MANUFACTURING
  CONSULTING
  REAL_ESTATE
  ENTERTAINMENT
  HOSPITALITY
  CONSTRUCTION
  TRANSPORTATION
  ENERGY
  TELECOMMUNICATIONS
  MARKETING
  NON_PROFIT
  GOVERNMENT
  OTHER
}

enum LocationType {
  HYBRID
  REMOTE
  ONSITE
}


enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}


enum ExperienceLevel {
  ENTRY
  MID
  SENIOR
  EXECUTIVE
}


enum JobStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}


enum ApplicationStatus {
  APPLIED
  REVIEWED
  SHORTLISTED
  INTERVIEWING
  REJECTED
  OFFER_EXTENDED
  ACCEPTED
  WITHDRAWN
}

enum InterviewType {
  SCREENING
  TECHNICAL
  FINAL
  HR
  SYSTEM_DESIGN
}

enum InterviewRequestStatus {
  SENT
  PENDING_CANDIDATE
  PENDING_RECRUITER
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
}

enum InterviewStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}


enum EducationLevel {
  HIGH_SCHOOL
  ASSOCIATE
  BACHELOR
  MASTER
  DOCTORATE
  DIPLOMA
  CERTIFICATION
  OTHER
}


enum FileType {
  PDF
  DOCX
  DOC
  TXT
}

enum ActionType {
  APPLICATION_APPLIED
  APPLIACTION_WITHDRAWN
  APPLICATION_SHORTLISTED
  APPLICATION_REVIEWED
  APPLICATION_REJECTED
  APPLICATION_OFFER
  APPLICATION_ACCEPTED
  INTERVIEW_REQUEST
  INTERVIEW_SCHEDULED
  INTERVIEW_ACCEPTED
}

model ActivityLog {
  id Int @id @default(autoincrement())
  userId Int
  actionType ActionType
  activityTitle String
  createdAt DateTime @default(now())

  user User @relation(fields:[userId], references: [id], onDelete: Cascade)

  @@index([id])
  @@index([userId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  profilePictureUrl String?
  contactPhone String?
  contactEmail String? 
  role         Role
  subscriptionPlan SubscriptionPlan @default(NON_PREMIUM)
  coverLetterGenerationCount Int @default(0)
  subscriptionExpiresAt DateTime?
  isOnboarded  Boolean  @default(false)
  isVerified   Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  
  otps      Otp[]
  recruiter RecruiterProfile?
  candidate CandidateProfile?
  ownedCompanies        Company[]
  subscriptionPayments SubscriptionPayment[]
  activityLogs ActivityLog[]
  interviewParticipants InterviewParticipant[]
}

model SubscriptionPayment {
  id            Int           @id @default(autoincrement())
  userId        Int
  amount        Float
  provider      String        @default("ESEWA")
  status        PaymentStatus @default(PENDING)
  transactionRef String       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([provider])
}

model Otp {
  id        Int      @id @default(autoincrement())
  code      Int
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  
  user User @relation(fields: [email], references: [email], onDelete: Cascade)

  @@index([email])
}

model Company {
  id               Int          @id @default(autoincrement())
  ownerId          Int
  name             String
  description      String?
  logoUrl          String?
  backgroundImgUrl String?
  websiteUrl       String?
  companyEmail     String
  companySize      CompanySize?
  industry         Industry?
  officeAddress    String?
  isVerified       Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  
  recruiters RecruiterProfile[]
  employees  CandidateProfile[] 
  jobs       Job[] 

  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([name])
  @@index([industry])
  @@index([companySize])
}

model RecruiterProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  companyId     Int
  positionTitle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs                Job[]
  interviewsConducted Interview[] @relation("RecruiterInterviews")
  interviewRequests InterviewRequest[]

  @@index([userId])
  @@index([companyId])
}

model CandidateProfile {
  id                Int                        @id @default(autoincrement())
  userId            Int                        @unique
  headline          String?
  currentPosition   String?
  currentCompanyId  Int?
  experienceYears   Int?
  highestDegree     EducationLevel?
  skills            String[] 
  preferredLocation String?
  preferredJobType  EmploymentType?
  expectedSalary    Float?
  embedding         CandidateProfileEmbedding?
  linkedinUrl       String?
  githubUrl         String?
  phone             String? 
  location          String? 
  summary           String? 
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCompany   Company?               @relation(fields: [currentCompanyId], references: [id], onDelete: SetNull)
  resumes          Resume[]
  applications     Application[]
  workHistory      WorkExperience[]
  education        Education[]
  savedJobs        SavedJob[]
  interviewRequests InterviewRequest[]
  interviewsJoined InterviewParticipant[]

  @@index([userId])
  @@index([skills]) 
  @@index([experienceYears])
  @@index([highestDegree])
}

model CandidateProfileEmbedding {
  id                 Int              @id @default(autoincrement())
  candidateProfileId Int              @unique
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(768)")?
  model     String  @default("all-mpnet-base-v2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateProfileId])
}

model WorkExperience {
  id          Int       @id @default(autoincrement())
  candidateId Int
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())

  
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Education {
  id           Int            @id @default(autoincrement())
  candidateId  Int
  institution  String
  degree       EducationLevel
  fieldOfStudy String?
  startDate    DateTime
  endDate      DateTime?
  gpa          Float?
  description  String?
  createdAt    DateTime       @default(now())

  
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Job {
  id                  Int              @id @default(autoincrement())
  companyId           Int 
  recruiterId         Int 
  title               String
  description         String
  requirements        String?
  employmentType      EmploymentType
  experienceLevel     ExperienceLevel?
  salaryRange         String?
  location            String
  locationType        LocationType
  remoteAvailable     Boolean          @default(false)
  status              JobStatus        @default(DRAFT)
  postedDate          DateTime?
  applicationDeadline DateTime?
  embedding           JobEmbedding?
  viewsCount          Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruiter    RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]
  interviewRequests InterviewRequest[]

  @@index([companyId])
  @@index([recruiterId])
  @@index([status])
  @@index([location])
  @@index([postedDate])
  @@index([employmentType])
  @@index([experienceLevel])
}

model JobEmbedding {
  id    Int @id @default(autoincrement())
  jobId Int @unique
  job   Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(768)")?
  model     String  @default("all-mpnet-base-v2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

model Resume {
  id          Int       @id @default(autoincrement())
  candidateId Int
  filePath    String 
  fileName    String
  fileType    FileType
  fileSize    Int 
  aiScore     Int 
  resumeText  String? 
  textContent String? 
  uploadedAt  DateTime? @default(now())
  createdAt   DateTime  @default(now())

  
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applications Application[] 

  @@index([candidateId])
  @@index([createdAt])
}

model Application {
  id           Int               @id @default(autoincrement())
  candidateId  Int
  jobId        Int
  resumeId     Int
  coverLetter  String?
  status       ApplicationStatus @default(APPLIED)
  hadInterview Boolean           @default(false)
  matchScore   Float? 
  appliedAt    DateTime          @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime          @updatedAt

  
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume    Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  interviews Interview[]

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([appliedAt])
  @@index([matchScore])
}

model SavedJob {
  id          Int      @id @default(autoincrement())
  candidateId Int
  jobId       Int
  createdAt   DateTime @default(now())

  
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

model InterviewParticipant {
  id          Int @id @default(autoincrement())
  interviewId Int
  userId      Int

  
  role     ParticipantRole   @default(CANDIDATE)
  status   ParticipantStatus @default(WAITING)
  joinedAt DateTime?          @default(now())

  interview          Interview         @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidateProfile   CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  candidateProfileId Int?

  @@unique([interviewId, userId])
}

model InterviewRequest {
  id  Int @id @default(autoincrement())
  jobId Int
  candidateId Int 
  recruiterId Int
  availableDateRange DateTime[]
  selectedDateTime DateTime?
  status InterviewRequestStatus @default(SENT)
  locationType LocationType
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  confirmedAt DateTime?

  job Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate CandidateProfile   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  recruiter RecruiterProfile      @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
}

model Interview {
  id            Int @id @default(autoincrement())
  applicationId Int
  interviewerId Int

  roomId        String    @unique
  recordingUrl  String?
  actualStartAt DateTime?
  actualEndAt   DateTime?

  
  interviewType InterviewType
  status        InterviewStatus       
  scheduledAt   DateTime
  meetingLink   String?
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  participants  InterviewParticipant[]

  application Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer RecruiterProfile @relation("RecruiterInterviews", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([interviewerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([roomId])
}
